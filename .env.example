# Copy to .env: docker compose and the backend (scripts, tests) read it.

# --- database ---
POSTGRES_USER=shifts
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shifts
# Database for the integration tests (created on the first start of the db container)
POSTGRES_TEST_DB=shifts_test
# Where the database is reached from the host, for local runs and tests.
# Inside docker compose the backend uses db:5432 regardless.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_PUBLISHED_PORT=5433

# --- start-up ---
# Demo accounts (empty database only): admin admin@example.com / admin12345,
# driver demo@example.com / demo12345 with sample shifts, driver erlan@example.com / erlan12345
SEED_DEMO=1

# First real admin, created on startup if the e-mail is not taken yet.
# Leave empty and use `docker compose run --rm bootstrap python -m scripts.create_admin <email>`
# instead if you prefer not to keep the password in a file.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to 1 when the app is served over HTTPS
COOKIE_SECURE=0
