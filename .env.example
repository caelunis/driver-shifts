# Copy to .env to override the defaults used by docker-compose.yml
POSTGRES_USER=shifts
POSTGRES_PASSWORD=shifts
POSTGRES_DB=shifts

# Demo accounts: driver demo@example.com / demo12345 with sample trips (empty database only)
# and admin admin@example.com / admin12345
SEED_DEMO=1

# First real admin, created on startup if the e-mail is not taken yet.
# Leave empty and use `docker compose exec app python -m app.create_admin <email>` instead
# if you prefer not to keep the password in a file.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to 1 when the app is served over HTTPS
COOKIE_SECURE=0
